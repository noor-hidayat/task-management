# Secret untuk Supabase Edge Function `drive`.
# Set via: supabase secrets set --env-file supabase/functions/.env
#
# ── Mode A: Gmail gratisan (OAuth user, disarankan) ──────────────
# 1) Aktifkan "Google Drive API" di Google Cloud Console.
# 2) APIs & Services → Credentials → Create Credentials → OAuth client ID
#    → tipe "Desktop app" → catat Client ID & Client Secret.
# 3) OAuth consent screen → isi nama app → tambah scope
#    https://www.googleapis.com/auth/drive.file → tambah email kamu
#    sebagai Test user.
# 4) Ambil refresh token via OAuth Playground:
#    https://developers.google.com/oauthplayground
#    - klik gear (Settings) → centang "Use your own OAuth credentials"
#      → isi Client ID & Secret → Close.
#    - cari scope "drive.file" → Authorize APIs → login Gmail → Allow.
#    - Exchange authorization code → salin "Refresh token".
# 5) Buat folder di My Drive (mis. Attachment) → salin ID dari URL:
#    drive.google.com/drive/folders/<FOLDER_ID>
#
# GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxx
# GOOGLE_REFRESH_TOKEN=1//0gxxx...
# GOOGLE_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
#
# ── Mode B: Workspace + Shared Drive (Service Account) ───────────
# 1) Buat Service Account → buat key JSON → ambil client_email & private_key.
# 2) Buat Shared Drive → tambah SA sebagai Content manager.
# 3) Buat folder di dalam Shared Drive → salin ID folder.
#
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com
# private_key boleh ditulis dengan \n literal (satu baris).
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# GOOGLE_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
#
# Catatan: kalau GOOGLE_REFRESH_TOKEN diset, mode OAuth dipakai
# dan kredensial Service Account diabaikan.

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
