# Secret untuk Supabase Edge Function `drive` (storage evidence).
# Set via: supabase secrets set --env-file supabase/functions/.env
#
# ── Cloudflare R2 (S3-compatible) ────────────────────────────────
# 1) Buat akun Cloudflare → dashboard → R2 → "Create bucket".
#    Catat nama bucket (mis. tims-evidence).
# 2) R2 → "Manage R2 API Tokens" → Create API token →
#    permission "Object Read & Write" → catat Access Key ID & Secret.
# 3) Account ID ada di dashboard R2 (sidebar / URL).
#
# R2_ACCOUNT_ID=<account-id-cloudflare>
# R2_ACCESS_KEY_ID=<access-key-id>
# R2_SECRET_ACCESS_KEY=<secret-access-key>
# R2_BUCKET=tims-evidence
#
# Opsional:
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # default dari ACCOUNT_ID
# R2_REGION=auto                                              # default "auto"
# R2_PREFIX=tims                                              # prefix root (rapi-rapi)
# R2_MAX_BYTES=9663676416                                     # batas kuota (default 9 GiB)

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
