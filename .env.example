# ── Supabase ──────────────────────────────────────────────
# Ambil dari: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ── Opsional: Supabase CLI (buat scripts/setup-r2.sh) ─────
# Buat di: https://supabase.com/dashboard/account/tokens
# Kalau kosong, pakai `npx supabase login` (login interaktif).
# SUPABASE_ACCESS_TOKEN=

# ── Catatan ───────────────────────────────────────────────
# Kredensial storage (Cloudflare R2) TIDAK di sini, tapi di
# supabase/functions/.env → dibaca oleh Edge Function.
# JANGAN commit file .env (sudah masuk .gitignore).
