# ── Supabase ──────────────────────────────────────────────
# Ambil dari: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ── Opsional: Supabase CLI (buat scripts/setup-storage.sh) ─
# Buat di: https://supabase.com/dashboard/account/tokens
# Kalau kosong, pakai `npx supabase login` (login interaktif).
# SUPABASE_ACCESS_TOKEN=

# ── Catatan ───────────────────────────────────────────────
# Storage memakai Supabase Storage (bucket `attachments` + `notes`).
# Tidak ada kredensial storage pihak ketiga yang perlu diisi — Edge Function
# memakai SUPABASE_URL + SERVICE_ROLE_KEY yang di-inject otomatis.
# JANGAN commit file .env (sudah masuk .gitignore).
